<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray5"
    android:orientation="vertical">

    <!-- 标题栏不在这里：本布局现在由页面 Fragment 使用，标题栏由宿主提供
         （手机端是壳 Activity 的 fragment_container_activity，平板是右栏的 PanePageFragment）。 -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:paddingLeft="@dimen/item_margin_left_and_right"
            android:paddingRight="@dimen/item_margin_left_and_right">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="@string/play_audio_message_in_earpiece"
                android:textColor="@color/black1"
                android:textSize="16sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchAudioPlayInEarpiece"
                style="@style/defaultSwitch"
                android:layout_gravity="center_vertical|right" />

        </FrameLayout>
    </LinearLayout>
</LinearLayout>
