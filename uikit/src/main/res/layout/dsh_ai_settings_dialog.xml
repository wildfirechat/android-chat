<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_bottom_sheet_bg"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <!-- 标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/dshAiTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/dsh_ai_title"
            android:textColor="@color/gray0"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dshAiClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minWidth="40dp"
            android:minHeight="40dp"
            android:textColor="@color/gray12"
            android:textSize="24sp" />
    </LinearLayout>

    <!-- 加载中提示 -->
    <TextView
        android:id="@+id/dshAiLoading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/dsh_ai_loading"
        android:textColor="@color/gray12"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- 可滚动内容区（小屏可滚动） -->
    <ScrollView
        android:id="@+id/dshAiScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxHeight="440dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 模型：下拉选择（type=3 model.options / model.current） -->
            <TextView
                style="@style/dsh_ai_label"
                android:text="@string/dsh_ai_model" />
            <Spinner
                android:id="@+id/dshAiModelSpinner"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/shape_dsh_input_bg"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:spinnerMode="dropdown" />

            <!-- 推理等级：下拉选择（type=3 effort.options / effort.current） -->
            <TextView
                style="@style/dsh_ai_label"
                android:text="@string/dsh_ai_effort" />
            <Spinner
                android:id="@+id/dshAiEffortSpinner"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/shape_dsh_input_bg"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:spinnerMode="dropdown" />

            <!-- 工作目录：当前值（只读）+ 切换按钮（目录候选来自 type=3 dirs，选择弹窗） -->
            <TextView
                style="@style/dsh_ai_label"
                android:text="@string/dsh_ai_cwd" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/dshAiCwdCurrent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="middle"
                    android:singleLine="true"
                    android:textColor="@color/gray12"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/dshAiCwdSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/shape_dsh_btn_secondary"
                    android:minWidth="64dp"
                    android:text="@string/dsh_ai_cwd_switch"
                    android:textAllCaps="false"
                    android:textColor="@color/gray0"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 目录候选列表（type=3 dirs）：loading 提示 + 列表容器 + 空/超时提示 -->
            <TextView
                android:id="@+id/dshAiCwdListLoading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:padding="10dp"
                android:text="@string/dsh_ai_cwd_list_loading"
                android:textColor="@color/gray12"
                android:textSize="12sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/dshAiCwdList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/shape_dsh_input_bg"
                android:orientation="vertical"
                android:visibility="gone" />

            <TextView
                android:id="@+id/dshAiCwdListEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:padding="10dp"
                android:text="@string/dsh_ai_cwd_list_empty"
                android:textColor="@color/gray12"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/dshAiCwdTip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/dsh_ai_cwd_tip"
                android:textColor="@color/gray12"
                android:textSize="11sp" />

            <!-- 沙箱模式 -->
            <TextView
                style="@style/dsh_ai_label"
                android:text="@string/dsh_ai_sandbox" />
            <RadioGroup
                android:id="@+id/dshAiSandboxGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="read-only"
                    android:text="@string/dsh_ai_sandbox_read_only" />

                <RadioButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:tag="workspace-write"
                    android:text="@string/dsh_ai_sandbox_workspace_write" />

                <RadioButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:tag="danger-full-access"
                    android:text="@string/dsh_ai_sandbox_danger" />
            </RadioGroup>

            <!-- 计划模式 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/dsh_ai_plan"
                    android:textColor="@color/gray0"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/dshAiPlanText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/gray12"
                    android:textSize="12sp" />

                <Switch
                    android:id="@+id/dshAiPlanSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- 压缩 / 重置 / 销毁（销毁为红色实底，危险操作始终可点，点击弹强警告确认） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/dshAiCompact"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:background="@drawable/shape_dsh_btn_secondary"
                    android:text="@string/dsh_ai_compact"
                    android:textAllCaps="false"
                    android:textColor="@color/gray0"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/dshAiReset"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/shape_dsh_btn_stop"
                    android:text="@string/dsh_ai_reset"
                    android:textAllCaps="false"
                    android:textColor="@color/red0"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/dshAiDestroy"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/shape_dsh_btn_destroy"
                    android:text="@string/dsh_ai_destroy"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 指令已发送提示 -->
            <TextView
                android:id="@+id/dshAiApplying"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/dsh_ai_applying"
                android:textColor="@color/colorPrimary"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
