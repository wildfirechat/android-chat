<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dshApprovalContentItemView"
    android:layout_width="260dp"
    android:layout_height="wrap_content"
    android:background="@drawable/img_bubble_receive"
    android:backgroundTint="@color/white"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/dshTitleTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔐 工具审批"
        android:textColor="@color/black"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/dshToolNameTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="monospace"
        android:textColor="@color/black"
        android:textSize="14sp"
        tools:text="bash" />

    <TextView
        android:id="@+id/dshReasonTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/gray11"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="原因：需要执行 shell 命令"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/dshActionsLinearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/dshApproveButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/shape_dsh_btn_primary"
            android:gravity="center"
            android:text="同意"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/dshRejectButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/shape_dsh_btn_reject"
            android:gravity="center"
            android:text="拒绝"
            android:textColor="@color/white"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 锁定态：已同意/已拒绝/已过期 -->
    <TextView
        android:id="@+id/dshStateTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/gray11"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="已同意"
        tools:visibility="visible" />

</LinearLayout>
