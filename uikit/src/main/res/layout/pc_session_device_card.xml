<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_device_card"
    android:orientation="vertical">

    <!-- 卡片头部（点击展开/收起）：小平台图标 + 设备名/客户端名竖排 + 展开箭头 -->
    <LinearLayout
        android:id="@+id/cardHeaderLayout"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/cardIconImageView"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_pc_computer" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/cardNameTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#333333"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Windows" />

            <TextView
                android:id="@+id/cardClientNameTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#999999"
                android:textSize="12sp"
                tools:text="DESKTOP-ABCD123" />
        </LinearLayout>

        <ImageView
            android:id="@+id/cardArrowImageView"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_chevron_down"
            android:tint="#999999" />
    </LinearLayout>

    <!-- 展开内容 -->
    <LinearLayout
        android:id="@+id/cardExpandedLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- 大平台图标 + 设备名 + 客户端名，居中 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:paddingBottom="16dp">

            <ImageView
                android:id="@+id/cardBigIconImageView"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_pc_computer" />

            <TextView
                android:id="@+id/cardExpandedNameTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#333333"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Windows" />

            <TextView
                android:id="@+id/cardExpandedClientNameTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#999999"
                android:textSize="13sp"
                tools:text="DESKTOP-ABCD123" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/line" />

        <!-- 手机通知（全局开关，控制手机静音） -->
        <LinearLayout
            android:id="@+id/cardMuteLayout"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/pc_session_phone_notify"
                android:textColor="#333333"
                android:textSize="16sp" />

            <Switch
                android:id="@+id/cardMuteSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="16dp"
            android:background="@color/line" />

        <!-- 锁定（仅桌面电脑类设备，非桌面设备由代码隐藏本行） -->
        <LinearLayout
            android:id="@+id/cardLockLayout"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/pc_session_lock"
                android:textColor="#333333"
                android:textSize="16sp" />

            <Switch
                android:id="@+id/cardLockSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="16dp"
            android:background="@color/line" />

        <!-- 传文件入口（跳文件传输助手） -->
        <LinearLayout
            android:id="@+id/cardFileLayout"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/send_file"
                android:textColor="#333333"
                android:textSize="16sp" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_chevron_right"
                android:tint="#999999" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="16dp"
            android:background="@color/line" />

        <!-- 退出该设备登录 -->
        <LinearLayout
            android:id="@+id/cardLogoutLayout"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cardLogoutTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FA5151"
                android:textSize="16sp"
                tools:text="退出Windows登录" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
