<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_bottom_sheet_bg"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <!-- 标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/agentAiTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/agent_ai_title"
            android:textColor="@color/gray0"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/agentAiClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minWidth="40dp"
            android:minHeight="40dp"
            android:textColor="@color/gray12"
            android:textSize="24sp" />
    </LinearLayout>

    <!-- 加载中提示 -->
    <TextView
        android:id="@+id/agentAiLoading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/agent_ai_loading"
        android:textColor="@color/gray12"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- 可滚动内容区（小屏可滚动） -->
    <ScrollView
        android:id="@+id/agentAiScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxHeight="440dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 沙箱模式 -->
            <TextView
                style="@style/agent_ai_label"
                android:text="@string/agent_ai_sandbox" />
            <RadioGroup
                android:id="@+id/agentAiSandboxGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="read-only"
                    android:text="@string/agent_ai_sandbox_read_only" />

                <RadioButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:tag="workspace-write"
                    android:text="@string/agent_ai_sandbox_workspace_write" />

                <RadioButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:tag="danger-full-access"
                    android:text="@string/agent_ai_sandbox_danger" />
            </RadioGroup>

            <!-- Agent 模式（preset）：下拉；options 为空时禁用但仍显示当前值 -->
            <TextView
                style="@style/agent_ai_label"
                android:text="@string/agent_ai_preset" />
            <Spinner
                android:id="@+id/agentAiPresetSpinner"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/shape_agent_input_bg"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:spinnerMode="dropdown" />

            <!-- 工具审批（approval）：同上，options 为空时禁用但仍显示当前值 -->
            <TextView
                style="@style/agent_ai_label"
                android:text="@string/agent_ai_approval" />
            <Spinner
                android:id="@+id/agentAiApprovalSpinner"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/shape_agent_input_bg"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:spinnerMode="dropdown" />

            <!-- 计划模式 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/agent_ai_plan"
                    android:textColor="@color/gray0"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/agentAiPlanText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/gray12"
                    android:textSize="12sp" />

                <Switch
                    android:id="@+id/agentAiPlanSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- 会话模式（mode）：interrupt（后到打断先到，默认）/ queue（排队），选项按 type=3 动态生成 -->
            <TextView
                style="@style/agent_ai_label"
                android:text="@string/agent_ai_mode" />
            <RadioGroup
                android:id="@+id/agentAiModeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- 上下文占用（scope=31 type=2 context.usedPct）+ 压缩上下文：进度指示在按钮之前 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/agentAiContextUsage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="76dp"
                    android:text="@string/agent_ai_context_unknown"
                    android:textColor="@color/gray12"
                    android:textSize="12sp" />

                <ProgressBar
                    android:id="@+id/agentAiContextProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:minHeight="6dp"
                    android:progress="0"
                    android:progressBackgroundTint="@color/gray13"
                    android:progressDrawable="@drawable/agent_context_progress"
                    android:progressTint="@color/colorPrimary" />

                <Button
                    android:id="@+id/agentAiCompact"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:background="@drawable/shape_agent_btn_secondary"
                    android:minWidth="112dp"
                    android:text="@string/agent_ai_compact"
                    android:textAllCaps="false"
                    android:textColor="@color/gray0"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 指令已发送提示 -->
            <TextView
                android:id="@+id/agentAiApplying"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/agent_ai_applying"
                android:textColor="@color/colorPrimary"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
