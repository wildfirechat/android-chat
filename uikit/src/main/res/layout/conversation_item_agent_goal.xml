<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/agentGoalContentItemView"
    android:layout_width="260dp"
    android:layout_height="wrap_content"
    android:background="@drawable/img_bubble_receive"
    android:backgroundTint="@color/white"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎯 目标进度"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/agentPhaseBadgeTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/shape_agent_phase_badge"
            android:paddingLeft="8dp"
            android:paddingTop="1dp"
            android:paddingRight="8dp"
            android:paddingBottom="1dp"
            android:textColor="@color/white"
            android:textSize="11sp"
            tools:text="进行中" />
    </LinearLayout>

    <TextView
        android:id="@+id/agentObjectiveTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/black"
        android:textSize="14sp"
        tools:text="目标描述" />

    <TextView
        android:id="@+id/agentRoundsTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/gray11"
        android:textSize="12sp"
        tools:text="已执行 3 轮" />

    <TextView
        android:id="@+id/agentStageTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/gray11"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="阶段：round 3"
        tools:visibility="visible" />

</LinearLayout>
