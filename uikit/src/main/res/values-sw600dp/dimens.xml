<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        宽屏下表单类内容（登录、验证码、协议确认等）的最大宽度。
        平板整宽拉伸的输入框既难看也难用，统一约束后居中显示。
        仅存在于 sw600dp 限定符下，手机不会引用到，因此对手机端无影响。
    -->
    <dimen name="wfc_form_max_width">400dp</dimen>

    <!-- 宽屏下卡片、协议确认这类文字较多的内容块最大宽度，比表单宽一些。 -->
    <dimen name="wfc_card_max_width">560dp</dimen>

    <!--
        消息列表左右留白。手机为 0dp（见 values/dimens.xml）。
        气泡自身 maxWidth 固定在 240dp 上下，宽屏下不收窄列表，左右气泡之间会拉出大片空档。
    -->
    <dimen name="wfc_message_list_padding_horizontal">48dp</dimen>

    <!-- 会话扩展面板左右留白，避免 8 个图标在宽屏上被等分拉得过于稀疏。 -->
    <dimen name="wfc_ext_panel_padding_horizontal">48dp</dimen>

    <!-- 主界面底部导航在宽屏下限宽居中，否则 4 个 tab 会散在整条屏幕上。阶段 4 侧边栏落地后本项作废。 -->
    <dimen name="wfc_bottom_nav_max_width">560dp</dimen>

</resources>
