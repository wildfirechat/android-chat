<resources>
    <!-- Default screen margins, per the Android Design guidelines. -->
    <dimen name="activity_horizontal_margin">16dp</dimen>

    <!--主界面底部图标大小-->

    <!--列表item间距-->
    <dimen name="item_margin_left_and_right">16dp</dimen>
    <dimen name="item_margin_top_and_bottom">5dp</dimen>

    <!--选项间距-->
    <dimen name="option_item_margin_top">10dp</dimen>
    <dimen name="option_item_margin_left">16dp</dimen>
    <dimen name="option_item_margin_right">16dp</dimen>

    <dimen name="min_keyboard_size">50dp</dimen>
    <dimen name="default_custom_keyboard_size">250dp</dimen>
    <dimen name="min_custom_keyboard_size">110dp</dimen>
    <dimen name="min_custom_keyboard_top_margin">170dp</dimen>
    <dimen name="min_custom_keyboard_top_margin_portrait">170dp</dimen>
    <dimen name="min_custom_keyboard_top_margin_landscape_bubble">56dp</dimen>

    <dimen name="dimen_30dp">30dp</dimen>
    <dimen name="dp_2">2dp</dimen>

    <!-- 投票功能尺寸 -->
    <dimen name="poll_button_width_large">200dp</dimen>

    <!--
        以下 wfc_* 为平板宽屏适配预留的留白量，手机一律为 0dp，
        即引用它们的默认布局在手机上渲染结果与改造前逐像素一致。
        平板取值见 values-sw600dp/dimens.xml。
    -->
    <!-- 消息列表左右留白：宽屏下气泡最大宽度固定，不收窄列表会导致中间出现巨大空档 -->
    <dimen name="wfc_message_list_padding_horizontal">0dp</dimen>
    <!-- 会话扩展面板（8 格功能区）左右留白：宽屏下不收窄，图标会被等分拉得极稀疏 -->
    <dimen name="wfc_ext_panel_padding_horizontal">0dp</dimen>

    <!--
        宽屏下由底部面板改成的居中对话框的最大宽度，见 WfcSheetDialogCompat。
        只在宽屏那条分支上被读到，手机端走的是 BottomSheet，取值与它无关；
        定义在无限定符下是因为它是从代码里按 id 引用的，缺省值必须存在。
    -->
    <dimen name="wfc_dialog_max_width">400dp</dimen>
</resources>
