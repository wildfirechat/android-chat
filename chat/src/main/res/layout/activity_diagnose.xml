<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 标题栏不在这里：本布局现在由页面 Fragment 使用，标题栏由宿主提供
         （手机端是壳 Activity 的 fragment_container_activity，平板是右栏的 PanePageFragment）。 -->

    <Button
        android:id="@+id/startTurnDiagnoseButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="开始 WEBRTC 测试" />

    <Button
        android:id="@+id/startDiagnoseButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="开始 IM 诊断" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="当前配置信息：" />

    <TextView
        android:id="@+id/configInfoTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="诊断结果：" />

    <TextView
        android:id="@+id/resultTextView"
        android:text="请点击 开始诊断 按钮，进行诊断"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>