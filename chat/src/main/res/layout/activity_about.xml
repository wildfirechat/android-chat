<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray5"
    android:orientation="vertical">

    <!-- 标题栏不在这里：本布局现在由页面 Fragment 使用，标题栏由宿主提供
         （手机端是壳 Activity 的 fragment_container_activity，平板是右栏的 PanePageFragment）。 -->

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="150dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:shapeAppearance="@style/RoundedCorners_8dp"
                android:src="@mipmap/ic_launcher" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/app_name"
                android:textColor="@color/gray2"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/infoTextView"
                android:layout_width="wrap_content"
                android:padding="16dp"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical">

        <cn.wildfire.chat.kit.widget.OptionItemView
            android:id="@+id/currentVersionOptionItemView"
            style="@style/OptionItem"
            app:title="当前版本" />

        <cn.wildfire.chat.kit.widget.OptionItemView
            android:id="@+id/introOptionItemView"
            style="@style/OptionItem"
            app:title="@string/function_introduction" />

        <cn.wildfire.chat.kit.widget.OptionItemView
            android:id="@+id/agreementOptionItemView"
            style="@style/OptionItem"
            app:title="用户协议" />

        <cn.wildfire.chat.kit.widget.OptionItemView
            android:id="@+id/privacyOptionItemView"
            style="@style/OptionItem"
            app:show_divider="false"
            app:title="隐私政策" />


    </LinearLayout>
</LinearLayout>