<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!--
        平板适配：不能声明为必需，否则无摄像头/无自动对焦的平板在应用市场会被过滤掉，无法安装。
        avenginekit 的 manifest 声明了这两个 feature 且未指定 required（默认为 true），
        合并时 true 会胜出，因此这里必须用 tools:replace 强制覆盖。
    -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false"
        tools:replace="android:required" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false"
        tools:replace="android:required" />
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />
    <!--
        音视频、拍照等页面仍锁定竖屏，aapt 会据此隐式加上 required=true 的
        android.hardware.screen.portrait，导致只支持横屏的设备被应用市场过滤。
        这里显式声明为非必需，两种屏幕方向的设备都能安装。
    -->
    <uses-feature
        android:name="android.hardware.screen.portrait"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.screen.landscape"
        android:required="false" />

    <!-- 通过GPS得到精确位置 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- 通过网络得到粗略位置 -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- 访问网络. 某些位置信息需要从网络服务器获取 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 访问网络状态, 检测网络的可用性. 需要网络运营商相关信息用于网络定位 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 访问网络的变化, 需要某些信息用于网络定位 -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- 访问手机当前状态, 需要某些信息用于网络定位 -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- 蓝牙分享所需的权限 -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />

    <!--
        音视频通话时，允许普通电话打断音视频通话，由 PstnCallMonitor 实现，依赖上面的 READ_PHONE_STATE 权限。
        不要使用 PROCESS_OUTGOING_CALLS 权限和 ACTION_NEW_OUTGOING_CALL 广播，二者在 API 29 已废弃，
        Android 10 及以上不再投递给三方应用。
    -->

    <application
        android:name="cn.wildfire.chat.app.MyApp"
        android:allowBackup="false"
        tools:replace="android:allowBackup"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:resizeableActivity="true"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true"
        tools:ignore="GoogleAppIndexingWarning">

        <meta-data
            android:name="android.webkit.WebView.EnableSafeBrowsing"
            android:value="true" />

        <!-- 地图 -->
        <!-- 腾讯地图的密钥是和包名绑定的，修改包名、或修改签名等时，需要自行去申请密钥，https://lbs.qq.com/ -->
        <meta-data
            android:name="TencentMapSDK"
            android:value="TOEBZ-67IR4-ZDHUV-DSDXX-TJZU7-UYFE7" />

        <activity
            android:name="cn.wildfire.chat.app.main.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="cn.wildfire.chat.app.main.AgreementActivity" />
        <activity
            android:name="cn.wildfire.chat.app.login.LoginActivity" />
        <activity
            android:name="cn.wildfire.chat.app.login.PadLoginActivity" />
        <activity
            android:name="cn.wildfire.chat.app.login.SMSLoginActivity" />
        <activity
            android:name="cn.wildfire.chat.app.setting.SettingActivity"
            android:label="@string/setting" />
        <activity
            android:name="cn.wildfire.chat.app.setting.AboutActivity"
            android:label="@string/about" />
        <activity
            android:name="cn.wildfire.chat.app.setting.backup.BackupAndRestoreActivity"
            android:label="@string/backup_and_restore" />
        <activity
            android:name="cn.wildfire.chat.app.setting.backup.RestoreProgressActivity"
            android:label="@string/backup_request" />
        <activity
            android:name="cn.wildfire.chat.app.setting.backup.RestoreSourceActivity"
            android:label="@string/select_restore_source" />
        <activity
            android:name="cn.wildfire.chat.app.setting.backup.BackupListActivity"
            android:label="@string/backup_list" />
        <activity
            android:name="cn.wildfire.chat.app.setting.backup.RestoreOptionsActivity"
            android:label="@string/restore_options" />
        <activity
            android:name="cn.wildfire.chat.app.setting.backup.PCRestoreListActivity"
            android:label="@string/pc_backup_list" />
        <activity
            android:name="cn.wildfire.chat.app.setting.backup.PCRestoreProgressActivity"
            android:label="@string/restoring_from_pc" />

        <activity
            android:name="cn.wildfire.chat.app.main.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="${applicationId}.main" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter android:label="@string/share_to_wildfire">
                <action android:name="android.intent.action.SENDTO" />
                <action android:name="android.intent.action.SEND" />
                <!--                <action android:name="android.intent.action.SEND_MULTIPLE" />-->
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <activity
            android:name="cn.wildfire.chat.app.main.PCLoginActivity"
            android:exported="false"
            android:label="@string/pc_login">
            <intent-filter>
                <action android:name="${packageName}.pc.login" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

        </activity>

        <activity android:name="cn.wildfire.chat.app.login.SMSLoginActivity" />

        <activity
            android:name="cn.wildfire.chat.app.setting.ChangePasswordActivity"
            android:label="@string/set_new_password" />
        <activity
            android:name="cn.wildfire.chat.app.setting.ResetPasswordActivity"
            android:label="@string/set_new_password" />
        <activity
            android:name="cn.wildfire.chat.app.setting.AccountActivity"
            android:label="@string/account_and_security" />
        <activity
            android:name="cn.wildfire.chat.app.misc.DiagnoseActivity"
            android:label="@string/diagnose" />
        <activity
            android:name="cn.wildfire.chat.app.voip.PstnDialActivity"
            android:label="电话助手" />

        <service
            android:name="cn.wildfire.chat.app.KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>
</manifest>
